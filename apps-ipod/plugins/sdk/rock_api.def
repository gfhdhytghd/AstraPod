/* Owned file descriptors and directory streams */
ROCK_SLOT(int (*open)(const char *, int, ...), open, rock_open)
ROCK_SLOT(int (*creat)(const char *, mode_t), creat, rock_creat)
ROCK_SLOT(int (*close)(int), close, rock_close)
ROCK_SLOT(ssize_t (*read)(int, void *, size_t), read, rock_read)
ROCK_SLOT(ssize_t (*write)(int, const void *, size_t), write, rock_write)
ROCK_SLOT(off_t (*lseek)(int, off_t, int), lseek, rock_lseek)
ROCK_SLOT(off_t (*ffilesize)(int), ffilesize, rock_ffilesize)
ROCK_SLOT(int (*fdprintf)(int, const char *, ...) ATTRIBUTE_PRINTF(2, 3), fdprintf, rock_fdprintf)
ROCK_SLOT(int (*read_line)(int, char *, int), read_line, rock_read_line)
ROCK_SLOT(bool (*file_exists)(const char *), file_exists, rock_file_exists)
ROCK_SLOT(DIR *(*opendir)(const char *), opendir, rock_opendir)
ROCK_SLOT(struct DIRENT *(*readdir)(DIR *), readdir, rock_readdir)
ROCK_SLOT(int (*closedir)(DIR *), closedir, rock_closedir)
ROCK_SLOT(struct dirinfo (*dir_get_info)(DIR *, struct DIRENT *), dir_get_info, rock_dir_get_info)

