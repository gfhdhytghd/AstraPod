/* AstraPod ABI slots in table order. GNU GPL version 2 or later. */

/* Display */
ROCK_DIRECT(lcd_update)
ROCK_DIRECT(lcd_update_rect)
ROCK_DIRECT(lcd_clear_display)
ROCK_DIRECT(lcd_getstringsize)
ROCK_DIRECT(lcd_putsxy)
ROCK_DIRECT(lcd_putsxyf)
ROCK_DIRECT(lcd_puts_scroll)
ROCK_DIRECT(lcd_scroll_stop)
ROCK_DIRECT(lcd_set_viewport)
ROCK_DIRECT(lcd_set_drawmode)
ROCK_DIRECT(lcd_get_drawmode)
ROCK_DIRECT(lcd_setfont)
ROCK_DIRECT(lcd_drawpixel)
ROCK_DIRECT(lcd_drawline)
ROCK_DIRECT(lcd_drawrect)
ROCK_DIRECT(lcd_fillrect)
ROCK_DIRECT(lcd_hline)
ROCK_DIRECT(lcd_vline)
ROCK_DIRECT(lcd_bitmap)
ROCK_DIRECT(lcd_bitmap_part)
ROCK_DIRECT(lcd_bitmap_transparent)
ROCK_DIRECT(lcd_mono_bitmap)
ROCK_DIRECT(lcd_set_backdrop)
ROCK_DIRECT(lcd_set_background)
ROCK_DIRECT(lcd_set_foreground)
ROCK_DIRECT(lcd_get_background)
ROCK_DIRECT(lcd_get_foreground)
ROCK_DIRECT(screen_clear_area)
ROCK_DIRECT(font_get)
ROCK_DIRECT(viewport_set_defaults)

/* Input and kernel */
ROCK_DIRECT(button_get)
ROCK_DIRECT(button_get_w_tmo)
ROCK_DIRECT(button_get_data)
ROCK_DIRECT(button_clear_queue)
ROCK_DIRECT(get_custom_action)
ROCK_DIRECT(sleep)
ROCK_DIRECT(yield)
ROCK_DIRECT(reset_poweroff_timer)
ROCK_SLOT(__typeof__(send_event) *send_event, send_event, rock_send_event)

/* Playback */
ROCK_DIRECT(audio_status)
ROCK_DIRECT(audio_stop)
ROCK_DIRECT(audio_pause)
ROCK_DIRECT(audio_resume)
ROCK_DIRECT(audio_prev)
ROCK_DIRECT(audio_next)
ROCK_DIRECT(audio_flush_and_reload_tracks)
ROCK_DIRECT(playlist_resume)
ROCK_DIRECT(playlist_resume_track)

/* System and utilities */
ROCK_DIRECT(get_time)
ROCK_DIRECT(commit_dcache)
ROCK_DIRECT(commit_discard_idcache)
ROCK_DIRECT(atoi)
ROCK_DIRECT(rand)
ROCK_DIRECT(snprintf)
ROCK_DIRECT(strcpy)
ROCK_DIRECT(strncpy)
ROCK_DIRECT(strcmp)
ROCK_DIRECT(strncmp)
ROCK_DIRECT(strcat)
ROCK_DIRECT(strlcpy)
ROCK_DIRECT(strlen)
ROCK_DIRECT(strrchr)
ROCK_DIRECT(memset)
ROCK_DIRECT(memcpy)
ROCK_DIRECT(memcmp)
ROCK_DIRECT(memmove)
ROCK_DIRECT(settings_parseline)

/* Native widgets and system events */
ROCK_SLOT(__typeof__(do_menu) *do_menu, do_menu, rock_do_menu)
ROCK_SLOT(__typeof__(set_int) *set_int, set_int, rock_set_int)
ROCK_SLOT(__typeof__(set_option) *set_option, set_option, rock_set_option)
ROCK_SLOT(__typeof__(option_screen) *option_screen, option_screen, rock_option_screen)
ROCK_SLOT(__typeof__(find_setting) *find_setting, find_setting, rock_find_setting)
ROCK_SLOT(__typeof__(settings_save) *settings_save, settings_save, rock_settings_save)
ROCK_SLOT(__typeof__(viewportmanager_theme_enable) *viewportmanager_theme_enable,
          viewportmanager_theme_enable, rock_theme_enable)
ROCK_SLOT(__typeof__(viewportmanager_theme_undo) *viewportmanager_theme_undo,
          viewportmanager_theme_undo, rock_theme_undo)
ROCK_SLOT(__typeof__(sb_set_persistent_title) *sb_set_persistent_title,
          sb_set_persistent_title, rock_set_title)
ROCK_SLOT(__typeof__(default_event_handler_ex) *default_event_handler_ex,
          default_event_handler_ex, rock_event_ex)
ROCK_SLOT(__typeof__(default_event_handler) *default_event_handler,
          default_event_handler, rock_event)
ROCK_SLOT(void (*splashf)(int, const char *, ...) ATTRIBUTE_PRINTF(2, 3), splashf, rock_splashf)

/* Owned file descriptors and directory streams */
ROCK_SLOT(int (*open)(const char *, int, ...), open, rock_open)
ROCK_SLOT(int (*creat)(const char *, mode_t), creat, rock_creat)
ROCK_SLOT(int (*close)(int), close, rock_close)
ROCK_SLOT(ssize_t (*read)(int, void *, size_t), read, rock_read)
ROCK_SLOT(ssize_t (*write)(int, const void *, size_t), write, rock_write)
ROCK_SLOT(off_t (*lseek)(int, off_t, int), lseek, rock_lseek)
ROCK_SLOT(off_t (*ffilesize)(int), ffilesize, rock_ffilesize)
ROCK_SLOT(int (*fdprintf)(int, const char *, ...) ATTRIBUTE_PRINTF(2, 3), fdprintf, rock_fdprintf)
ROCK_SLOT(int (*read_line)(int, char *, int), read_line, rock_read_line)
ROCK_SLOT(bool (*file_exists)(const char *), file_exists, rock_file_exists)
ROCK_SLOT(DIR *(*opendir)(const char *), opendir, rock_opendir)
ROCK_SLOT(struct DIRENT *(*readdir)(DIR *), readdir, rock_readdir)
ROCK_SLOT(int (*closedir)(DIR *), closedir, rock_closedir)
ROCK_SLOT(struct dirinfo (*dir_get_info)(DIR *, struct DIRENT *), dir_get_info, rock_dir_get_info)

/* Foreground arena and data */
ROCK_SLOT(bool (*plugin_usb_taken)(void), plugin_usb_taken, rock_usb_taken)
ROCK_SLOT(void *(*plugin_get_buffer)(size_t *), plugin_get_buffer, rock_get_buffer)
ROCK_SLOT(size_t (*plugin_reserve_buffer)(size_t), plugin_reserve_buffer, rock_reserve_buffer)
ROCK_SLOT(const char *(*plugin_get_current_filename)(void),
          plugin_get_current_filename, rock_get_current_filename)
ROCK_SLOT(volatile const long *current_tick, current_tick, &current_tick)
ROCK_SLOT(struct screen *screens[NB_SCREENS], screens, { &screens[SCREEN_MAIN] })
ROCK_SLOT(ROCK_SETTINGS_TYPE *global_settings, global_settings, ROCK_SETTINGS_VIEW)
ROCK_SLOT(struct system_status *global_status, global_status, &global_status)
ROCK_SLOT(unsigned char **language_strings, language_strings, ROCK_LANGUAGE_VIEW)
