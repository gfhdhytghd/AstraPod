wide_predict:
    ; A7 = residual cursor, A8 = oldest history, s11 = samples left. Y:e13
    ; reads a signed residual high limb and stores the reconstructed low bit.
    yld(s3, ORDER)
    ldi s2, #WBASE-1
    alu s3, s2, s3, #OP_ADD
    x17.mve e13, s3
    ; The two disjoint 1056-word X buffers hold H and B for 1024 new
    ; samples plus at most 32 carried samples. Duplicate warm-up B into X.
    aimm_o(6, 0x900)
    aimm_e(5, 0x900)
    lde e8, #WBASE
    yld(s7, ORDER)
wp_warm:
    ldy s1, e8
    x18.eagu e8, e8, #AGU_INC
    pks(1, A13, 0, s0, s0, 0)
    again(s7, wp_warm)
    ; Rounded predictor uses t=q+3, after merging the bit-plane into its 48-bit dot.
    yld(s10, LPCSHIFT)
    ldi s4, #3
    alu s10, s10, s4, #OP_ADD
    alu s13, s10, s14, #OP_ADD
    ldi s4, #24
    alu s15, s13, s4, #OP_SUB
    ldi s3, #-1
    alu s3, s15, s3, #ASR
    alu s3, s0, s3, #OP_SUB
    alu s3, s3, s14, #OP_SUB
    aimm_o(1, 0x240)
    pks(3, A3, 0, s0, s0, 0)
    aimm_e(2, 0x240)
    yld(s5, ORDER)
    equals(12, wp_hot12)
    equals(8, wp_hot8)
    equals(4, wp_hot4)
    equals(2, wp_hot2)
wp_sample:
    x03.agu A9, A8, #0, #0, A0
    x03.agu A5, A10, #0, #0, A0
    aimm_o(5, 0x200)
    yld(s7, ORDER)
    x03.tap0 s4, #9, s0, s2, s3
    x03.tap0 s6, #5, s0, s8, s9
    x03.tap s5, #11, s0, s2, s3
    ldi s1, #3
    x18.and s12, s1, s7
    ptst p3, s0, #EQ12, #PTST
    jmp #IF_NOT, #3, wp_tap
    nop()
    nop()
    ldi s1, #2
    alu s7, s1, s7, #ASR
wp_four:
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    again(s7, wp_four)
    jmp #ALWAYS, #0, wp_unscale
    nop()
    nop()
wp_tap:
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    again(s7, wp_tap)
wp_unscale:
    ; Bacc=16*sum(c*B). The extra MAC adds half of it into the H accumulator.
    ; Combined signed48 result is 8*sum(c*(2*H+B)).
    ldi s1, #4
    alu s6, s1, s9, #ASR
    x03.tap s6, #5, s1, s2, s3
    alu s6, s10, s3, #ASR
    x18.and s6, s6, s14
    alu s3, s13, s3, #ASR
    x19.xrd s8, #4
    x18.and s3, s3, s8
    alu s2, s15, s2, #ASR
    x18.or s3, s2, s3
    ; Sum floor(P/2), floor(R/2), and the bit-zero carry directly modulo 24.
    x19.xrd s4, #7
    x18.and s5, s4, s14
    alu s4, s14, s4, #ASR
    ldy s8, e13
    ldi s1, #-15
    alu s8, s1, s8, #ASR
    x18.or s4, s8, s4
    alu s1, s4, s3, #OP_ADD
    x18.and s8, s5, s6
    alu s1, s1, s8, #OP_ADD
    pk(s0, A0, s0, s0, s0, 6, s6, s5, 0, 31)
    wstore()
    pks(6, A13, 0, s0, s0, 0)
    x02.ainc #10, #10
    x02.ainc #8, #8
    again(s11, wp_sample)
    ldi s15, #-8
    yld(s13, 0x2d96)
    jmp #ALWAYS, #0, wide_output
    nop()
    nop()
wp_hot12:
    x03.agu A9, A8, #0, #0, A0
    x03.agu A5, A10, #0, #0, A0
    aimm_o(5, 0x200)
    x03.tap0 s4, #9, s0, s2, s3
    x03.tap0 s6, #5, s0, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    ; Bacc=16*sum(c*B). The extra MAC adds half of it into the H accumulator.
    ; Combined signed48 result is 8*sum(c*(2*H+B)).
    ldi s1, #4
    alu s6, s1, s9, #ASR
    x03.tap s6, #5, s1, s2, s3
    alu s6, s10, s3, #ASR
    x18.and s6, s6, s14
    alu s3, s13, s3, #ASR
    x19.xrd s8, #4
    x18.and s3, s3, s8
    alu s2, s15, s2, #ASR
    x18.or s3, s2, s3
    ; Sum floor(P/2), floor(R/2), and the bit-zero carry directly modulo 24.
    x19.xrd s4, #7
    x18.and s5, s4, s14
    alu s4, s14, s4, #ASR
    ldy s8, e13
    ldi s1, #-15
    alu s8, s1, s8, #ASR
    x18.or s4, s8, s4
    alu s1, s4, s3, #OP_ADD
    x18.and s8, s5, s6
    alu s1, s1, s8, #OP_ADD
    pk(s0, A0, s0, s0, s0, 6, s6, s5, 0, 31)
    wstore()
    pks(6, A13, 0, s0, s0, 0)
    x02.ainc #10, #10
    x02.ainc #8, #8
    again(s11, wp_hot12)
    ldi s15, #-8
    yld(s13, 0x2d96)
    jmp #ALWAYS, #0, wide_output
    nop()
    nop()
wp_hot8:
    x03.agu A9, A8, #0, #0, A0
    x03.agu A5, A10, #0, #0, A0
    aimm_o(5, 0x200)
    x03.tap0 s4, #9, s0, s2, s3
    x03.tap0 s6, #5, s0, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    ; Bacc=16*sum(c*B). The extra MAC adds half of it into the H accumulator.
    ; Combined signed48 result is 8*sum(c*(2*H+B)).
    ldi s1, #4
    alu s6, s1, s9, #ASR
    x03.tap s6, #5, s1, s2, s3
    alu s6, s10, s3, #ASR
    x18.and s6, s6, s14
    alu s3, s13, s3, #ASR
    x19.xrd s8, #4
    x18.and s3, s3, s8
    alu s2, s15, s2, #ASR
    x18.or s3, s2, s3
    ; Sum floor(P/2), floor(R/2), and the bit-zero carry directly modulo 24.
    x19.xrd s4, #7
    x18.and s5, s4, s14
    alu s4, s14, s4, #ASR
    ldy s8, e13
    ldi s1, #-15
    alu s8, s1, s8, #ASR
    x18.or s4, s8, s4
    alu s1, s4, s3, #OP_ADD
    x18.and s8, s5, s6
    alu s1, s1, s8, #OP_ADD
    pk(s0, A0, s0, s0, s0, 6, s6, s5, 0, 31)
    wstore()
    pks(6, A13, 0, s0, s0, 0)
    x02.ainc #10, #10
    x02.ainc #8, #8
    again(s11, wp_hot8)
    ldi s15, #-8
    yld(s13, 0x2d96)
    jmp #ALWAYS, #0, wide_output
    nop()
    nop()
wp_hot4:
    x03.agu A9, A8, #0, #0, A0
    x03.agu A5, A10, #0, #0, A0
    aimm_o(5, 0x200)
    x03.tap0 s4, #9, s0, s2, s3
    x03.tap0 s6, #5, s0, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    ; Bacc=16*sum(c*B). The extra MAC adds half of it into the H accumulator.
    ; Combined signed48 result is 8*sum(c*(2*H+B)).
    ldi s1, #4
    alu s6, s1, s9, #ASR
    x03.tap s6, #5, s1, s2, s3
    alu s6, s10, s3, #ASR
    x18.and s6, s6, s14
    alu s3, s13, s3, #ASR
    x19.xrd s8, #4
    x18.and s3, s3, s8
    alu s2, s15, s2, #ASR
    x18.or s3, s2, s3
    ; Sum floor(P/2), floor(R/2), and the bit-zero carry directly modulo 24.
    x19.xrd s4, #7
    x18.and s5, s4, s14
    alu s4, s14, s4, #ASR
    ldy s8, e13
    ldi s1, #-15
    alu s8, s1, s8, #ASR
    x18.or s4, s8, s4
    alu s1, s4, s3, #OP_ADD
    x18.and s8, s5, s6
    alu s1, s1, s8, #OP_ADD
    pk(s0, A0, s0, s0, s0, 6, s6, s5, 0, 31)
    wstore()
    pks(6, A13, 0, s0, s0, 0)
    x02.ainc #10, #10
    x02.ainc #8, #8
    again(s11, wp_hot4)
    ldi s15, #-8
    yld(s13, 0x2d96)
    jmp #ALWAYS, #0, wide_output
    nop()
    nop()
wp_hot2:
    x03.agu A9, A8, #0, #0, A0
    x03.agu A5, A10, #0, #0, A0
    aimm_o(5, 0x200)
    x03.tap0 s4, #9, s0, s2, s3
    x03.tap0 s6, #5, s0, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    x03.tap s4, #9, s5, s2, s3
    x03.tap s6, #5, s5, s8, s9
    x03.tap s5, #11, s0, s2, s3
    ; Bacc=16*sum(c*B). The extra MAC adds half of it into the H accumulator.
    ; Combined signed48 result is 8*sum(c*(2*H+B)).
    ldi s1, #4
    alu s6, s1, s9, #ASR
    x03.tap s6, #5, s1, s2, s3
    alu s6, s10, s3, #ASR
    x18.and s6, s6, s14
    alu s3, s13, s3, #ASR
    x19.xrd s8, #4
    x18.and s3, s3, s8
    alu s2, s15, s2, #ASR
    x18.or s3, s2, s3
    ; Sum floor(P/2), floor(R/2), and the bit-zero carry directly modulo 24.
    x19.xrd s4, #7
    x18.and s5, s4, s14
    alu s4, s14, s4, #ASR
    ldy s8, e13
    ldi s1, #-15
    alu s8, s1, s8, #ASR
    x18.or s4, s8, s4
    alu s1, s4, s3, #OP_ADD
    x18.and s8, s5, s6
    alu s1, s1, s8, #OP_ADD
    pk(s0, A0, s0, s0, s0, 6, s6, s5, 0, 31)
    wstore()
    pks(6, A13, 0, s0, s0, 0)
    x02.ainc #10, #10
    x02.ainc #8, #8
    again(s11, wp_hot2)
    ldi s15, #-8
    yld(s13, 0x2d96)
    jmp #ALWAYS, #0, wide_output
    nop()
    nop()
wide_zero:
    ; Fixed order zero: residual is the sample, with no predictor dot product.
    aimm_o(4, AUDIO)
    aimm_o(3, AUDIO)
    lde e13, #WBASE
    yld(s11, BLOCK)
wzero_sample:
    pk(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0)
    ldy s2, e13
    x18.and s6, s1, s14
    alu s1, s14, s1, #ASR
    ldi s4, #-15
    alu s2, s4, s2, #ASR
    x18.or s1, s1, s2
    wstore()
    again(s11, wzero_sample)
wide_output:
    save_history()
    ; Restore any wasted bits before linear stereo/filter combinations.
    yld(s4, WASTE)
    alu s12, s4, s0, #OP_ADD
    ptst p3, s0, #EQ12, #PTST
    jmp #3, #3, wide_groups
    alu s4, s0, s4, #OP_SUB
    alu s5, s4, s14, #OP_ADD
    aimm_o(4, AUDIO)
    aimm_o(3, AUDIO)
    lde e13, #WBASE
    yld(s11, BLOCK)
waste_side:
    pk(s1, A9, s0, s0, s0, 0, s0, s0, 0, 0)
    ldy s2, e13
    alu s1, s4, s1, #ASR
    alu s2, s5, s2, #ASR
    alu s1, s1, s2, #OP_ADD
    ldi s6, #0
    wstore()
    again(s11, waste_side)
wide_groups:
    jmp #ALWAYS, #0, pcm_entry
    nop()
    nop()
