+    fb_data *output = (fb_data *)dst->data;
+    for (int y = 0; y < LCD_HEIGHT; ++y) {
+        const fb_data *row = input + (y * src->height / LCD_HEIGHT) * src->width;
+        unsigned x = 0;
+        for (int i = 0; i < LCD_WIDTH; ++i, x += src->width)
+            *output++ = row[x / LCD_WIDTH];
+    }
