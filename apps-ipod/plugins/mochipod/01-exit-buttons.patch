Answer "Save and exit?" with the buttons: Center quits, Menu stays.
The wheel no longer toggles the answer, so the prompt shows no choice dots.

diff --git a/src/core/ui.c b/src/core/ui.c
index 603711a..dda2a49 100644
--- a/src/core/ui.c
+++ b/src/core/ui.c
@@ -62,7 +62,7 @@ int ui_count(const Ui *u,const Pet *p)
     case OFFER: return 2;
     case HOME: return ICON_COUNT;
     case STATUS: return p->character==V3_LEGACY ? 7 : 11;
-    case FOOD: case TRAIN: case EXIT_ASK: case HATCH_ASK: case REPLACE_ASK: case INPUT_MODE: return 2;
+    case FOOD: case TRAIN: case HATCH_ASK: case REPLACE_ASK: case INPUT_MODE: return 2;
     case ACTIV_MENU:return 5;
     case ITEMS:return owned_count(p,false,false);
     case OPTIONS: return 5;
@@ -250,6 +250,12 @@ void ui_command(Ui *u,Pet *p,enum Command cmd)
         if (u->page!=EXIT_ASK) enter(u,EXIT_ASK);
         return;
     }
+    if (u->page==EXIT_ASK) {
+        /* Center quits and Menu stays; the wheel does not answer. */
+        if (cmd==CMD_OK) u->exit_requested=true;
+        else if (cmd==CMD_BACK || cmd==CMD_CANCEL) back(u);
+        return;
+    }
     if (u->page==OFFER && (cmd==CMD_BACK || cmd==CMD_CANCEL)) {
         family_answer(p,false);home(u);return;
     }
